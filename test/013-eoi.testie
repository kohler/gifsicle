%script
gifsicle -O2 boundary.gif -o actual.gif
cmp actual.gif expected.gif
gifdiff boundary.gif actual.gif
gifsicle -U trimmed-eoi.gif -o /dev/null 2>&1

%file -e boundary.gif
R0lGODdhDgABAPH/AAAAAFVVVaqqqv///ywAAAAADgABAAACB8yAoRMIUQAAOw==

%file -e expected.gif
R0lGODdhDgABAPEAAAAAAFVVVf///wAAACwAAAAADgABAAACB4yAoRIIUQAAOw==

%file -e trimmed-eoi.gif
R0lGODdhDgABAPEAAAAAAFVVVf///wAAACwAAAAADgABAAACBoyAoRIIUQA7

%expect stdout
gifsicle:trimmed-eoi.gif: warning: missing end-of-information code
